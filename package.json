{
    "name": "spacekitchen",
    "private": true,
    "version": "0.0.0",
    "description": "Walk around a Gaussian-splat space kitchen.",
    "license": "MIT",
    "author": "Isaac Mason",
    "type": "module",
    "packageManager": "pnpm@10.32.1",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "preview": "vite preview",
        "lint": "biome check .",
        "format": "biome format --write .",
        "check": "biome check --write .",
        "build:collider": "node scripts/build-collider.ts"
    },
    "dependencies": {
        "@pmndrs/glyph": "0.1.0",
        "crashcat": "^0.0.5",
        "mathcat": "0.0.13",
        "spark-radix": "github:asundqui/radix-test#22cdb1702f66231b3cc6440f35154ec9a81242f3",
        "three": "^0.186.0"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.0",
        "@gltf-transform/core": "^4.5.1",
        "@types/three": "^0.186.0",
        "meshoptimizer": "^1.3.0",
        "typescript": "~6.0.2",
        "vite": "^8.0.12"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "spark-radix",
            "esbuild"
        ],
        "overrides": {
            "three": "$three",
            "@types/three": "$@types/three"
        }
    }
}
